#!/bin/sh
# Redmi AX6 无线默认设置：在 Kwrt 的 10-wifi-detect 之后重新应用
[ "${ACTION}" = "add" ] || exit 0

(
    for i in $(seq 1 30); do
        [ "$(uci -q get base_config.@status[0].wifi 2>/dev/null)" = "1" ] && break
        sleep 1
    done

    apply_wifi() {
        local radio iface band
        for radio in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\(radio[0-9][0-9]*\)=wifi-device$/\1/p'); do
            band="$(uci -q get wireless.$radio.band 2>/dev/null)"
            iface="$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([a-zA-Z0-9_]*\)\.device='$radio'\$/\1/p" | head -n1)"
            [ -z "$iface" ] && iface="default_$radio"
            case "$band" in
                5g)
                    uci set wireless.$radio.disabled='0'
                    uci set wireless.$iface.disabled='0'
                    uci set wireless.$iface.ssid='AA_5G'
                    uci set wireless.$iface.encryption='psk2'
                    uci set wireless.$iface.key='asd12345'
                    ;;
                2g)
                    uci set wireless.$radio.disabled='1'
                    uci set wireless.$iface.disabled='1'
                    ;;
            esac
        done
    }
    apply_wifi
    uci commit wireless
    /sbin/wifi up
) &
exit 0