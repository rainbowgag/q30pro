#!/bin/sh
# Redmi AX6 首次启动：LAN / 关闭 IPv6 / 5G WiFi(AA_5G) / 2.4G 禁用 / OpenClash 锁定

# LAN 地址（config_generate 用 list ipaddr，先删后加并带 /24 前缀）
uci -q del network.lan.ipaddr
uci add_list network.lan.ipaddr='192.168.100.1/24'

# 关闭 IPv6
uci -q delete network.wan6
uci -q delete network.lan.ip6assign
uci -q delete network.globals.ula_prefix
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.ndp='disabled'

# WiFi：按 band 识别（Redmi AX6 实测 radio0=5G/QCN5054，radio1=2.4G/QCA9887）
# 5G 启用 AA_5G/asd12345；2.4G 默认禁用
apply_wifi() {
    local radio iface band
    for radio in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\(radio[0-9][0-9]*\)=wifi-device$/\1/p'); do
        band="$(uci -q get wireless.$radio.band 2>/dev/null)"
        iface="$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([a-zA-Z0-9_]*\)\.device='$radio'\$/\1/p" | head -n1)"
        [ -z "$iface" ] && iface="default_$radio"
        case "$band" in
            5g)
                uci set wireless.$radio.disabled='0'
                uci set wireless.$iface.disabled='0'
                uci set wireless.$iface.ssid='AA_5G'
                uci set wireless.$iface.encryption='psk2'
                uci set wireless.$iface.key='asd12345'
                ;;
            2g)
                uci set wireless.$radio.disabled='1'
                uci set wireless.$iface.disabled='1'
                ;;
        esac
    done
}
apply_wifi

# OpenClash：Meta 内核 + fake-ip-mix 混合模式 + 默认配置 + 锁定（禁自更新，默认不启动）
uci set openclash.config.core_version='linux-arm64'
uci set openclash.config.en_mode='fake-ip-mix'
uci set openclash.config.config_path='/etc/openclash/config/config.yaml'
uci set openclash.config.auto_update='0'
uci set openclash.config.update='0'
uci set openclash.config.auto_update_time='0'
uci set openclash.config.enable='0'

uci commit
exit 0