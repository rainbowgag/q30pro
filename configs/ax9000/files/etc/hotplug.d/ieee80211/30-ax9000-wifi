#!/bin/sh
# Xiaomi AX9000 三频无线默认设置：在 Kwrt 的 10-wifi-detect 生成无线配置后，按 band+path 重新应用。
# 三频：2.4G(AA_2.4G) / 5G 主频(AA_5G,160M) / 5G 游戏频(AA_5G_Game)。密码 asd12345。
# 注意：160MHz 在 CN 法规域不可用（5.2G 全被 NO_IR），改用 US 以启用 160MHz（DFS）。
[ "${ACTION}" = "add" ] || exit 0

(
    for i in $(seq 1 30); do
        [ "$(uci -q get base_config.@status[0].wifi)" = "1" ] && break
        sleep 1
    done

    for radio in radio0 radio1 radio2; do
        band="$(uci -q get wireless.$radio.band)" || continue
        path="$(uci -q get wireless.$radio.path)"

        case "$band" in
            2g)
                ssid="AA_2.4G"; htmode="HE20"; channel="auto"; country="CN"
                ;;
            5g)
                if echo "$path" | grep -q "c000000.wifi"; then
                    ssid="AA_5G"; htmode="HE160"; channel="100"; country="US"
                else
                    ssid="AA_5G_Game"; htmode="HE80"; channel="149"; country="US"
                fi
                ;;
            *)
                continue
                ;;
        esac

        uci set wireless.$radio.disabled='0'
        uci set wireless.$radio.country="$country"
        uci set wireless.$radio.htmode="$htmode"
        uci set wireless.$radio.channel="$channel"
        uci set wireless.default_$radio.ssid="$ssid"
        uci set wireless.default_$radio.encryption='psk2'
        uci set wireless.default_$radio.key='asd12345'
        uci set wireless.default_$radio.disabled='0'
    done

    uci commit wireless
    /sbin/wifi up
) &
exit 0